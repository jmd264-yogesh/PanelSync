# ==============================================================================
# PanelSync Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL
# ------------------------------------------------------------------------------
# The base URL of the running application (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Microsoft Entra ID (Azure AD) Single Sign-On & MS Graph API
# ------------------------------------------------------------------------------
# App Registration configured with Web redirect URI:
# ${NEXT_PUBLIC_APP_URL}/api/auth/callback
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# ------------------------------------------------------------------------------
# 3. Database Connection (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/panelsync

# ------------------------------------------------------------------------------
# 4. Session Security
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing session tokens (must be at least 32 characters).
SESSION_SECRET=your_super_secret_session_key_min_32_chars

# ------------------------------------------------------------------------------
# 5. AI Interview Copilot (Google Gemini API)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 6. Resume Storage (Vercel Blob)
# ------------------------------------------------------------------------------
# Read/Write token for Vercel Blob storage (https://vercel.com/docs/storage/vercel-blob)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token

# ------------------------------------------------------------------------------
# 7. Audio & Media Storage (AWS S3 / Floci Local Emulator)
# ------------------------------------------------------------------------------
# For local development with Floci:
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=panel-sync-audio
#
# For production AWS S3 (leave AWS_ENDPOINT_URL blank or omitted):
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=panel-sync-audio